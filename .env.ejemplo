# ----------------------------------------------------------------------------
# Configuración de SIRVE-P para docker compose.
# Copiar a .env y rellenar. NO se versiona.
# ----------------------------------------------------------------------------

# Base
DB_NAME=SIRVE
DB_ADMIN_USER=User_app
DB_PASSWORD=cambia-esta-clave-de-administracion

# Rol de la aplicación (ver 33-rol-aplicacion.sql)
DB_APP_USER=sirve_app
DB_PASSWORD_APP=cambia-esta-clave-de-la-app

# Puerto para el Caddy de desarrollo (perfil "local")
PUERTO_HTTP=9081

# ----------------------------------------------------------------------------
# En el servidor, sin dominio todavía
# ----------------------------------------------------------------------------
# La imagen que publica el pipeline en GitHub Container Registry. Con esto el
# compose no compila nada en la máquina: descarga y arranca.
#
# IMAGEN_APP=ghcr.io/franciscoalvaradocarreon/sirve:latest
#
# Detrás del Caddy del SIH, la aplicación no publica puertos: se alcanza por
# la red externa "proxy" y el sitio se declara en el Caddyfile del SIH.